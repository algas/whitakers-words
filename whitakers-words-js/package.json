{
  "name": "whitakers-words-js",
  "version": "1.0.0",
  "description": "JavaScript implementation of Whitaker's Words Latin-English dictionary",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "words": "./bin/words.js"
  },
  "scripts": {
    "test": "node --test test/*.js",
    "words": "node bin/words.js",
    "makedict": "node bin/makedict.js",
    "makestem": "node bin/makestem.js",
    "makeinfl": "node bin/makeinfl.js",
    "makeewds": "node bin/makeewds.js",
    "debug:analyze": "node debug/analyze-word.js",
    "debug:duplicates": "node debug/investigate-duplicates.js",
    "debug:inflections": "node debug/test-inflections.js"
  },
  "keywords": ["latin", "dictionary", "linguistics", "whitakers-words"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}